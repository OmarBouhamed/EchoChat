# App Configuration
APP_NAME=SupportGPT
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true

# API
API_HOST=0.0.0.0
API_PORT=8000

# Database
DATABASE_URL=postgresql+asyncpg://supportgpt:supportgpt_password@postgres:5432/supportgpt_db
DATABASE_ECHO=true

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_TTL=3600

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60